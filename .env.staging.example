# Staging environment for docker-compose.prod.yml.
#
# Copy to .env.staging and fill in real values — it is gitignored, never committed.
# Every value below must be DIFFERENT from the production .env.production file
# (D-16: no production secret is used in staging), even though both run the same
# production build.

# Always "production": staging is the production build running locally (D-16),
# not a separate build mode.
NODE_ENV=production
# Single public address Caddy serves; web and the API are same-origin behind it (ADR 0003)
SITE_ADDRESS=http://localhost:8080
# PostgreSQL user for this environment's database only
POSTGRES_USER=change-me
# PostgreSQL password — must differ from production's
POSTGRES_PASSWORD=change-me
# Database name — must differ from production's (separate data, never shared)
POSTGRES_DB=sms_staging
# Prisma connection string; keep in sync with the POSTGRES_* values above.
# "postgres" is the database service's name on the compose network, not a host port.
DATABASE_URL=postgresql://change-me:change-me@postgres:5432/sms_staging?schema=public
# Port the API listens on inside its container
API_PORT=4000
# Pino log level for the API (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info
# Email transport: must stay "smtp" — "console" is refused whenever NODE_ENV=production
EMAIL_TRANSPORT=smtp
# SMTP host for outgoing email (D-10: provider not chosen yet)
SMTP_HOST=change-me
# SMTP port
SMTP_PORT=587
# SMTP auth
SMTP_USER=change-me
# SMTP auth
SMTP_PASSWORD=change-me
# "From" address used on outgoing emails
MAIL_FROM=no-reply@school-management-system.local
# The web app's public base URL; reset/verification email links are built from it
APP_URL=http://localhost:8080
# Number of proxy hops in front of the API ("trust proxy"); 1 because Caddy sits in front
TRUST_PROXY=1
