# PostgreSQL user that Docker Compose creates and the API connects as
POSTGRES_USER=sms
# PostgreSQL password for the local-only database (not a real secret)
POSTGRES_PASSWORD=sms
# Name of the local PostgreSQL database
POSTGRES_DB=sms
# Host port PostgreSQL is published on; change it if 5432 is already in use
POSTGRES_PORT=5432
# Prisma connection string; keep it in sync with the POSTGRES_* values above
DATABASE_URL=postgresql://sms:sms@localhost:5432/sms?schema=public
# Port the Express API listens on
API_PORT=4000
# Base URL the web app uses to reach the API
API_URL=http://localhost:4000
# Pino log level for the API (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info
# Email transport: "smtp" (Mailpit locally) or "console" (dev only, logs emails instead of sending them); refused in production
EMAIL_TRANSPORT=smtp
# Mailpit SMTP host for local email testing
SMTP_HOST=localhost
# Mailpit SMTP port
SMTP_PORT=1025
# SMTP auth; empty locally (Mailpit needs none)
SMTP_USER=
# SMTP auth; empty locally (Mailpit needs none)
SMTP_PASSWORD=
# "From" address used on outgoing emails
MAIL_FROM=no-reply@school-management-system.local
# The web app's public base URL; reset/verification email links are built from it
APP_URL=http://localhost:3000
# Number of proxy hops in front of the API ("trust proxy"); 0 locally, no proxy in front
TRUST_PROXY=0
# Shared password for the local-only demo users created by `pnpm db:seed` (never used in production)
SEED_DEMO_PASSWORD=demo-password-123
